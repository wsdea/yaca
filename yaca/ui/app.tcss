Screen {
  layout: vertical;
  overflow-x: hidden;
  background: #0f172a;
  color: #e5e7eb;
}

#top {
  height: auto;
  padding: 0 1;
  overflow-x: hidden;
  background: #111827;
  color: #e5e7eb;
  border: heavy #1f2937;
}

#status_row {
  height: auto;
  align: left middle;
}

#status {
  height: auto;
  padding: 0 1 0 0;
  margin: 0;
  color: #93c5fd;
}

#open_files {
  height: auto;
  padding: 0;
  margin: 0;
  overflow-x: hidden;
  text-wrap: wrap;
  color: #d1d5db;
  border: none;
  outline: none;
  background: transparent;
}

#open_files:focus,
#open_files:focus-within,
#open_files:hover {
  background: transparent;
  border: none;
  outline: none;
}

#open_files > CollapsibleTitle,
#open_files > CollapsibleTitle > CollapsibleTitleToggle,
#open_files > CollapsibleTitle > CollapsibleTitleLabel,
#open_files CollapsibleTitle,
#open_files CollapsibleTitleToggle,
#open_files CollapsibleTitleLabel,
#open_files CollapsibleTitle:focus,
#open_files CollapsibleTitle:focus-within,
#open_files CollapsibleTitle:hover,
#open_files CollapsibleTitleToggle:focus,
#open_files CollapsibleTitleToggle:focus-within,
#open_files CollapsibleTitleToggle:hover,
#open_files CollapsibleTitleLabel:focus,
#open_files CollapsibleTitleLabel:focus-within,
#open_files CollapsibleTitleLabel:hover {
  padding: 0;
  margin: 0;
  background: transparent;
  color: #93c5fd;
  border: none;
  outline: none;
}

#open_files > CollapsibleContent,
#open_files CollapsibleContent,
#open_files CollapsibleContent:focus,
#open_files CollapsibleContent:focus-within,
#open_files CollapsibleContent:hover {
  padding: 0;
  padding-top: 0;
  margin: 0;
  margin-top: 0;
  background: transparent;
  border: none;
  outline: none;
}

#open_files > CollapsibleContent > *:first-child,
#open_files CollapsibleContent > *:first-child {
  margin-top: 0;
  padding-top: 0;
}

#open_files_content {
  padding: 0;
  margin: 0;
}

