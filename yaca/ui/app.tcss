#todo {
  padding: 0;
  margin: 0;
  border: none;
  outline: none;
  background: transparent;
}

#todo:focus,
#todo:focus-within,
#todo:hover {
  background: transparent;
  border: none;
  outline: none;
}

#todo > CollapsibleTitle,
#todo > CollapsibleTitle > CollapsibleTitleToggle,
#todo > CollapsibleTitle > CollapsibleTitleLabel,
#todo CollapsibleTitle,
#todo CollapsibleTitleToggle,
#todo CollapsibleTitleLabel,
#todo CollapsibleTitle:focus,
#todo CollapsibleTitle:focus-within,
#todo CollapsibleTitle:hover,
#todo CollapsibleTitleToggle:focus,
#todo CollapsibleTitleToggle:focus-within,
#todo CollapsibleTitleToggle:hover,
#todo CollapsibleTitleLabel:focus,
#todo CollapsibleTitleLabel:focus-within,
#todo CollapsibleTitleLabel:hover {
  padding: 0;
  margin: 0;
  background: transparent;
  color: #93c5fd;
  border: none;
  outline: none;
}

#todo > CollapsibleContent,
#todo CollapsibleContent,
#todo CollapsibleContent:focus,
#todo CollapsibleContent:focus-within,
#todo CollapsibleContent:hover {
