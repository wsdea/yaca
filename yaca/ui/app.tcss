#todo > CollapsibleContent > *:first-child,
#todo CollapsibleContent > *:first-child {
  margin-top: 0;
  padding-top: 0;
}

#todo_content {
  padding: 0;
  margin: 0;
}

#chat_scroll {
  height: 1fr;
  padding: 0 1;
  overflow-x: hidden;
  background: #0b1220;
}

#chat {
  width: 100%;
  height: auto;
  overflow-x: hidden;
  text-wrap: wrap;
  color: #e5e7eb;
}

#bottom {
  height: auto;
  padding: 0 1 1 1;
  overflow-x: hidden;
  background: #111827;
  border-top: heavy #1f2937;
}

#chat_input {
  width: 100%;
  height: auto;
  min-height: 3;
  overflow-x: hidden;
  scrollbar-size-vertical: 1;
  background: #0b1220;
  color: #e5e7eb;
  border: heavy #1f2937;
}
