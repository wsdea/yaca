#running_subagents CollapsibleContent:focus-within,
#running_subagents CollapsibleContent:hover {
  padding: 0;
  padding-top: 0;
  margin: 0;
  margin-top: 0;
  background: transparent;
  border: none;
  outline: none;
}

#running_subagents > CollapsibleContent > *:first-child,
#running_subagents CollapsibleContent > *:first-child {
